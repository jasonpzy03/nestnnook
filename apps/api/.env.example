# Copy to .env for a real deployment. Never put secrets in Angular files.
NODE_ENV=production
PORT=3000
ADMIN_ORIGIN=https://admin.example.com
ADMIN_EMAIL=admin@example.com
# Run npm run setup locally to generate a unique password and hash.
ADMIN_PASSWORD_HASH=
STORAGE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=nestnnook
# Local uploads require a persistent filesystem. Production uses HTTPS photo URLs
# until an object-storage provider is configured.
ALLOW_LOCAL_UPLOADS=false
