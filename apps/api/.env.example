# Copy to .env for a real deployment. Never put secrets in Angular files.
NODE_ENV=production
PORT=3000
ADMIN_ORIGIN=https://admin.example.com
# Run npm run setup locally to generate a unique password and hash.
ADMIN_PASSWORD_HASH=
STORAGE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=nestnnook
# Production: connect a public Vercel Blob store to the API project.
# Keep this token on the API only, never in the Angular apps.
BLOB_READ_WRITE_TOKEN=
# Local uploads require a persistent filesystem; disabled on Vercel.
# until an object-storage provider is configured.
ALLOW_LOCAL_UPLOADS=false
