{
  "name": "nest-and-nook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve nest-and-nook --host 127.0.0.1",
    "build": "ng build nest-and-nook && node scripts/seo.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:admin": "ng serve nest-and-nook-admin --host 127.0.0.1 --port 4201",
    "build:admin": "ng build nest-and-nook-admin",
    "start:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "setup:api": "npm --prefix apps/api run setup",
    "test:api": "npm --prefix apps/api test",
    "serve:ssr": "node --env-file-if-exists=.env dist/server/server.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:ssr": "node scripts/test-ssr.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/platform-server": "^21.2.23",
    "@angular/ssr": "^21.2.24",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@types/node": "^22.20.5",
    "angular-cli-ghpages": "^3.1.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3"
  }
}
